{
    "name": "fubon-trading",
    "private": true,
    "version": "0.0.0",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
        "desktop:qa": "tauri build --debug --config src-tauri/tauri.dev.conf.json",
        "build": "tsc -b && vite build",
        "test": "vitest run",
        "preview": "vite preview",
        "start": "node scripts/dev-fubon.mjs",
        "credentials": "uv run --directory server fubon-credentials",
        "passkeys": "uv run --directory server fubon-passkeys",
        "server": "uv run --directory server fubon-bridge",
        "test:server": "uv run --directory server --extra test pytest",
        "test:ui": "node scripts/verify-shadcn.mjs"
    },
    "dependencies": {
