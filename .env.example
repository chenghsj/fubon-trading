# demo = synthetic data + local paper book, no login
# paper = Fubon real quotes + local paper book, requires the SDK and credentials
# live = real brokerage orders; BOTH settings must opt in explicitly
FUBON_MODE=demo
FUBON_ENABLE_LIVE_TRADING=false

# Credentials are stored only in macOS Keychain:
# pnpm credentials set | status | delete
# Do not put personal ID, API Key, certificate path/password in this file.

# regular = day; afterhours = night. Restart after changes.
FUBON_SESSION=regular
# Futures: contracts. Stock Common: lots (1000 shares each).
FUBON_MAX_ORDER_QUANTITY=10

# pnpm start uses isolated loopback ports: API 21323, UI 5179.
VITE_API_TARGET=http://127.0.0.1:21323
